<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - School Feedback System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <div class="container" style="max-width: 1200px;">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:20px;">
            <div>
                <h2 style="margin:0;">Admin Dashboard</h2>
                <p style="margin:8px 0 0; color:#475569;">Ticket management queue</p>
            </div>
            <div>
                <a href="/" class="secondary-link">Back to Home</a>
                <span class="divider">|</span>
                <a href="/auth/logout" class="secondary-link">Log Out</a>
            </div>
        </div>

        <div class="quick-stats" style="margin-top:20px; margin-bottom:25px;">
            <div class="stat-card">
                <strong><%= totalTickets || 0 %></strong>
                <span>Total Tickets</span>
            </div>
            <div class="stat-card">
                <strong><%= submittedCount || 0 %></strong>
                <span>Submitted</span>
            </div>
            <div class="stat-card">
                <strong><%= progressCount || 0 %></strong>
                <span>In Review</span>
            </div>
            <div class="stat-card">
                <strong><%= resolvedCount || 0 %></strong>
                <span>Resolved</span>
            </div>
        </div>

        <% if (tickets.length === 0) { %>
            <div class="alert-success">No feedback tickets found in the system yet.</div>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>Tracking Code</th>
                        <th>Category / Title</th>
                        <th>Location</th>
                        <th>Submitter</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% tickets.forEach(ticket => { %>
                        <tr>
                            <td><strong><%= ticket.tracking_code %></strong></td>
                            <td>
                                <span class="status-pill" style="font-size:11px; background:#e2e8f0; color:#334155; margin-bottom:6px; display:inline-block;"><%= ticket.category %></span><br>
                                <strong><%= ticket.title %></strong><br>
                                <small><%= ticket.description %></small>
                            </td>
                            <td><%= ticket.location %></td>
                            <td><%= ticket.is_anonymous ? 'Anonymous' : 'Authenticated User' %></td>
                            <td><span class="status-pill"><%= ticket.status %></span></td>
                            <td>
                                <form action="/admin/ticket/<%= ticket.id %>/update" method="POST" style="min-width:200px;">
                                    <select name="status" style="margin-bottom: 8px;">
                                        <option value="Submitted" <%= ticket.status === 'Submitted' ? 'selected' : '' %>>Submitted</option>
                                        <option value="Under Review" <%= ticket.status === 'Under Review' ? 'selected' : '' %>>Under Review</option>
                                        <option value="In Progress" <%= ticket.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                                        <option value="Resolved" <%= ticket.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                                        <option value="Closed" <%= ticket.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                                    </select>
                                    <input type="text" name="admin_remarks" placeholder="Add official remark..." value="<%= ticket.admin_remarks || '' %>" style="margin-bottom: 8px;">
                                    <button type="submit" class="btn btn-success" style="width:100%;">Update Ticket</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
</body>
</html>