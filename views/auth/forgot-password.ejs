<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - EDUVoice</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="forgot-body">
  <div class="forgot-screen">
    <div class="forgot-brand-panel">
      <div class="forgot-brand-content">
        <div class="edu-logo">EDUVoice</div>
        <div class="brand-tag">Campus Feedback Portal</div>
      </div>

      <div class="forgot-heading-wrap">
        <h1>Reset your<br>password.</h1>
        <p>
          Enter your campus email and we will record your reset request.
        </p>
      </div>
    </div>

    <div class="forgot-auth-panel">
      <div class="forgot-card">
        <h2>Forgot Password</h2>
        <p class="forgot-subhead">We’ll help you recover your account</p>
        <p class="forgot-subhead"><small>Demo version: reset emails are not sent yet. Please contact the system administrator to reset your password.</small></p>

        <% if (error) { %>
          <div class="alert-error"><%= error %></div>
        <% } %>

        <% if (successMessage) { %>
          <div class="alert-success"><%= successMessage %></div>
        <% } %>

        <form action="/auth/forgot-password" method="POST">
          <div class="form-group">
            <label for="email">Campus Email</label>
            <div class="input-wrap">
              <span class="input-icon">✉</span>
              <input type="email" id="email" name="email" placeholder="username@student.univ.edu" required maxlength="100" autocomplete="email">
            </div>
          </div>

          <button type="submit" class="forgot-submit-btn">Request Reset</button>
        </form>

        <div class="forgot-link">
          Back to <a href="/auth/login">Sign In</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
