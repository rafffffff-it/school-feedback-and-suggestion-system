<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - EDUVoice</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">
  <div class="login-screen">
    <div class="brand-panel">
      <div class="brand-content">
        <div class="edu-logo">EDUVoice</div>
        <div class="brand-tag">Campus Feedback Portal</div>
        <div class="brand-copy">
          Connecting students, teachers, and administration for a better school community
        </div>
      </div>
    </div>

    <div class="auth-panel">
      <div class="auth-card">
        <h1>School Feedback and Suggestion System</h1>
        <h2>Welcome back !!!</h2>

        <% if (error) { %>
          <div class="alert-error"><%= error %></div>
        <% } %>

        <% if (successMessage) { %>
          <div class="alert-success"><%= successMessage %></div>
        <% } %>

        <form method="POST" action="/auth/login">
          <label class="form-label" for="email">Email</label>
          <div class="field-wrap">
            <span class="field-icon">◌</span>
            <input id="email" type="email" name="email" placeholder="Enter your campus email" required maxlength="100" autocomplete="email">
          </div>

          <label class="form-label" for="password">Password</label>
          <div class="field-wrap">
            <span class="field-icon">◒</span>
            <input id="password" type="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
          </div>

          <button class="primary-btn" type="submit">Login</button>
        </form>

        <div class="form-links">
          <a href="/auth/forgot-password">Forgot Password?</a>
          <a href="/auth/register">Create Account</a>
        </div>

        <!-- Back to Home Action -->
        <div style="text-align: center; margin-top: 20px; padding-top: 15px; border-top: 1px solid #e2e8f0;">
          <a href="/" class="secondary-link" style="color: #475569; font-size: 0.9rem; text-decoration: none;">← Back to Home</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>