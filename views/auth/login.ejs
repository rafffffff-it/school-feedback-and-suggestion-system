<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - EDUVoice</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">
  <div class="login-screen">
    <div class="brand-panel">
      <div class="brand-content">
        <div class="edu-logo">EDUVoice</div>
        <div class="brand-tag">description</div>
        <div class="brand-copy">
          Connecting students, teachers, and<br>
          administration for a better school<br>
          community
        </div>
      </div>
    </div>

    <div class="auth-panel">
      <div class="auth-card">
        <h1>School Feedback and<br>Suggestion System</h1>
        <h2>Welcome back !!!</h2>

        <% if (error) { %>
          <div class="alert-error"><%= error %></div>
        <% } %>

        <% if (successMessage) { %>
          <div class="alert-success"><%= successMessage %></div>
        <% } %>

        <form method="POST" action="/auth/login">
          <label class="form-label" for="email">Username</label>
          <div class="field-wrap">
            <span class="field-icon">◌</span>
            <input id="email" type="email" name="email" placeholder="Enter your username" required>
          </div>

          <label class="form-label" for="password">Password</label>
          <div class="field-wrap">
            <span class="field-icon">◒</span>
            <input id="password" type="password" name="password" placeholder="••••••••" required>
          </div>

          <button class="primary-btn" type="submit">Login</button>
        </form>

        <div class="form-links">
          <a href="/auth/forgot-password">Forgot Password?</a>
          <a href="/auth/register">Create Account</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
