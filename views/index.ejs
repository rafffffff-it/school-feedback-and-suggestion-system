<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School Feedback & Suggestion System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-body" style="overflow: hidden;">
    <div class="simple-page" style="max-width: 800px; margin-top: 20px;">
        <div class="simple-card" style="text-align: center; padding: 30px;">
            <p style="color: #a46549; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.08em; margin-bottom: 6px;">Campus Services Portal</p>
            <h1 style="color: #234b37; font-family: Georgia, serif; font-size: 2.2rem; margin-bottom: 12px;">Campus Feedback & Suggestion System</h1>
            <p style="color: #676a64; font-size: 1rem; line-height: 1.4; margin-bottom: 22px;">A secure digital channel to report issues, submit improvement ideas, and monitor the status of requests across the campus.</p>

            <!-- Stacked Action Buttons -->
            <div style="display: flex; flex-direction: column; align-items: center; gap: 10px; margin-bottom: 22px;">
                <a class="dashboard-action primary" href="/feedback/new" style="width: 100%; max-width: 320px; padding: 10px 20px;">Submit New Feedback</a>
                <a class="dashboard-action secondary" href="/feedback/track" style="width: 100%; max-width: 320px; padding: 10px 20px;">Track Ticket Status</a>
            </div>

            <div style="border-top: 1px solid #e3e1dc; padding-top: 18px; margin-top: 18px;">
                <% if (session && session.user) { %>
                    <p style="margin-bottom: 12px;">Logged in as <strong><%= session.user.name %></strong> (<%= session.user.role %>)</p>
                    <% if (session.user.role === 'admin') { %>
                        <a href="/admin/dashboard" class="simple-back-link">Go to Admin Dashboard</a>
                    <% } else { %>
                        <a href="/dashboard" class="simple-back-link">My Dashboard</a> | 
                        <a href="/auth/profile" class="simple-back-link">My Profile</a>
                    <% } %>
                    | <a href="/auth/logout" class="simple-back-link" style="color: #a46549;">Log Out</a>
                <% } else { %>
                    <a href="/auth/login" class="simple-back-link">Login</a> | 
                    <a href="/auth/register" class="simple-back-link">Create Account</a>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>