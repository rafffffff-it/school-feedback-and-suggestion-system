<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School Feedback & Suggestion System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div style="max-width: 600px; margin: 60px auto; padding: 20px; font-family: Arial, sans-serif; text-align: center;">
        <h1>Campus Feedback & Suggestion System</h1>
        <p>A secure digital channel to submit suggestions, report campus facility issues, and track progress.</p>
        
        <div style="margin-top: 30px;">
            <a href="/feedback/new" style="background: #007BFF; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px; margin-right: 10px; display: inline-block;">Submit New Feedback</a>
            <a href="/feedback/track" style="background: #28a745; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block;">Track Ticket Status</a>
        </div>

        <!-- Added Admin / Login Portal Link -->
        <div style="margin-top: 40px; border-top: 1px solid #eaeaea; padding-top: 20px;">
            <% if (typeof session !== 'undefined' && session.user) { %>
                <p style="font-size: 14px; color: #555;">Logged in as <strong><%= session.user.name %></strong> (<%= session.user.role %>)</p>
                <% if (session.user.role === 'admin') { %>
                    <a href="/admin/dashboard" style="color: #007BFF; text-decoration: none; font-weight: bold; margin-right: 15px;">Go to Admin Dashboard</a>
                <% } %>
                <a href="/auth/logout" style="color: #dc3545; text-decoration: none; font-size: 14px;">Log Out</a>
            <% } else { %>
                <a href="/auth/login" style="color: #6c757d; text-decoration: none; font-size: 14px;">Administrator / Staff Login</a>
            <% } %>
        </div>
    </div>
</body>
</html>