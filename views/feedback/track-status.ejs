<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Track Suggestion Status</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <div class="auth-card" style="max-width: 700px;">
        <p><a href="/" class="secondary-link">← Back to Home</a></p>
        <h2>Track Your Feedback Status</h2>

        <form action="/feedback/track" method="POST" style="margin-bottom: 20px;">
            <div class="form-group">
                <label>Enter Tracking Code</label>
                <input type="text" name="tracking_code" required placeholder="e.g., TCK-ABC123" style="text-transform: uppercase;">
            </div>
            <button type="submit" class="btn btn-success">Track Status</button>
        </form>

        <% if (error) { %>
            <div class="alert-error"><%= error %></div>
        <% } %>

        <% if (ticket) { %>
            <div class="card-panel">
                <h3>Ticket Details</h3>
                <p><strong>Tracking Code:</strong> <%= ticket.tracking_code %></p>
                <p><strong>Category:</strong> <%= ticket.category %></p>
                <p><strong>Title:</strong> <%= ticket.title %></p>
                <p><strong>Location:</strong> <%= ticket.location %></p>
                <p><strong>Description:</strong> <%= ticket.description %></p>

                <% if (ticket.attachment_path) { %>
                    <p><strong>Attachment:</strong> <a href="<%= ticket.attachment_path %>" target="_blank">View Uploaded Evidence</a></p>
                <% } %>

                <p><strong>Current Status:</strong> <span class="status-pill"><%= ticket.status %></span></p>
                <p><strong>Last Updated:</strong> <%= ticket.updated_at %></p>

                <% if (ticket.admin_remarks) { %>
                    <p><strong>Official Remarks:</strong> <%= ticket.admin_remarks %></p>
                <% } %>
            </div>
        <% } %>

        <div class="auth-links">
            <p><a href="/feedback/new">Submit a new feedback ticket</a></p>
        </div>
    </div>
</body>
</html>