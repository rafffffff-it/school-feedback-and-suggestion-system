<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submit Feedback - School Feedback System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div style="max-width: 600px; margin: 40px auto; padding: 20px; font-family: Arial, sans-serif;">
        <!-- Back Button Added -->
        <p><a href="/" style="text-decoration: none; color: #007bff; font-weight: bold;">← Back to Home</a></p>

        <h2>Submit Campus Feedback or Suggestion</h2>
        
        <!-- Added enctype for multipart file uploads -->
        <form action="/feedback/new" method="POST" enctype="multipart/form-data">
            
            <div style="margin-bottom: 15px;">
                <label>Category:</label><br>
                <select name="category" required style="width: 100%; padding: 8px;">
                    <option value="Campus Facilities">Campus Facilities</option>
                    <option value="Academic Services">Academic Services</option>
                    <option value="Cafeteria & Health">Cafeteria & Health</option>
                    <option value="Accessibility & Safety">Accessibility & Safety</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div style="margin-bottom: 15px;">
                <label>Title / Issue Summary:</label><br>
                <input type="text" name="title" required style="width: 100%; padding: 8px;" placeholder="e.g., Broken projector in Room 402">
            </div>

            <div style="margin-bottom: 15px;">
                <label>Location / Room Details:</label><br>
                <input type="text" name="location" required style="width: 100%; padding: 8px;" placeholder="e.g., Science Building, 2nd Floor">
            </div>

            <div style="margin-bottom: 15px;">
                <label>Description:</label><br>
                <textarea name="description" rows="5" required style="width: 100%; padding: 8px;" placeholder="Provide clear details about your suggestion or issue..."></textarea>
            </div>

            <!-- File Upload Field (10MB limit, Images/PDFs) -->
            <div style="margin-bottom: 15px;">
                <label>Attach Supporting File / Evidence (Optional, Max 10MB - Images or PDF):</label><br>
                <input type="file" name="attachment" accept=".jpg, .jpeg, .png, .gif, .pdf" style="width: 100%; padding: 8px; box-sizing: border-box;">
            </div>

            <div style="margin-bottom: 15px;">
                <label>
                    <input type="checkbox" name="is_anonymous"> Submit Anonymously
                </label>
            </div>

            <button type="submit" style="background: #007BFF; color: white; padding: 10px 20px; border: none; cursor: pointer;">Submit Ticket</button>
        </form>
    </div>
</body>
</html>