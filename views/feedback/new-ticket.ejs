<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Record - EDUVoice</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-body">
    <div class="dashboard-shell">
        <aside class="dashboard-sidebar">
            <a class="dashboard-logo" href="/dashboard">EDUVoice</a>
            <nav class="dashboard-nav" aria-label="Main navigation">
                <a class="dashboard-nav-item" href="/dashboard"><span aria-hidden="true">⌂</span>Dashboard</a>
                <a class="dashboard-nav-item" href="/feedback/mine"><span aria-hidden="true">♧</span>My Feedback</a>
                <a class="dashboard-nav-item active" href="/feedback/new" aria-current="page"><span aria-hidden="true">✎</span>Submit Suggestion</a>
                <a class="dashboard-nav-item" href="/dashboard#campus-announcements"><span aria-hidden="true">⚑</span>Campus Notices</a>
                <a class="dashboard-nav-item" href="/auth/profile"><span aria-hidden="true">♙</span>Profile</a>
                <a class="dashboard-nav-item" href="/auth/settings"><span aria-hidden="true">⚙</span>Settings</a>
            </nav>
            <a class="dashboard-nav-item dashboard-logout" href="/auth/logout"><span aria-hidden="true">⇥</span>Logout</a>
        </aside>

        <main class="record-main">
            <header class="record-header">
                <h1>Add New Record</h1>
                <span><%= session && session.user ? (session.user.role === 'admin' ? 'Campus Administrator' : session.user.name) : 'Campus Community' %></span>
            </header>

            <section class="record-card">
                <div class="record-card-heading">
                    <h2>Add Feedback/Suggestion Record</h2>
                    <p>Enter the details below to create a new campus record</p>
                </div>

                <% if (error) { %>
                    <div class="alert-error"><%= error %></div>
                <% } %>

                <% if (successMessage) { %>
                    <div class="alert-success feedback-success">
                        <strong>Record submitted successfully</strong>
                        <span><%= successMessage %></span>
                        <a href="/feedback/mine">View feedback records</a>
                    </div>
                <% } %>

                <form action="/feedback/new" method="POST" enctype="multipart/form-data" class="record-form">
                    <div class="record-form-grid">
                        <div class="record-field">
                            <label for="title">Record Title</label>
                            <input id="title" type="text" name="title" required minlength="5" maxlength="255" value="<%= formData ? formData.title || '' : '' %>" placeholder="Enter a concise title for the feedback">
                        </div>

                        <div class="record-field">
                            <label for="category">Category</label>
                            <select id="category" name="category" required>
                                <option value="">Select category...</option>
                                <option value="Campus Facilities" <%= formData && formData.category === 'Campus Facilities' ? 'selected' : '' %>>Campus Facilities</option>
                                <option value="Academic Services" <%= formData && formData.category === 'Academic Services' ? 'selected' : '' %>>Academic Services</option>
                                <option value="Cafeteria & Health" <%= formData && formData.category === 'Cafeteria & Health' ? 'selected' : '' %>>Cafeteria & Health</option>
                                <option value="Accessibility & Safety" <%= formData && formData.category === 'Accessibility & Safety' ? 'selected' : '' %>>Accessibility & Safety</option>
                                <option value="Other" <%= formData && formData.category === 'Other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>

                        <div class="record-field">
                            <label for="location">Location / Room</label>
                            <input id="location" type="text" name="location" required maxlength="255" value="<%= formData ? formData.location || '' : '' %>" placeholder="Building, room, or campus area">
                        </div>

                        <div class="record-field record-privacy-field">
                            <label>Submitted By</label>
                            <label class="record-anonymous-option" for="is_anonymous">
                                <input type="checkbox" name="is_anonymous" id="is_anonymous" <%= formData && formData.is_anonymous === 'on' ? 'checked' : '' %>>
                                <span>Submit anonymously</span>
                            </label>
                            <small>Your account is associated with the record unless you choose anonymous submission.</small>
                        </div>

                        <div class="record-field record-full-width">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" rows="4" required minlength="10" placeholder="Provide detailed description of the feedback or suggestion..."><%= formData ? formData.description || '' : '' %></textarea>
                        </div>

                        <div class="record-field record-full-width">
                            <label for="attachment">Attachments <span>(Optional)</span></label>
                            <label class="record-file-picker" for="attachment">
                                <span aria-hidden="true">⌁</span>
                                <span class="record-file-label">Upload File (PDF, PNG, JPG)</span>
                                <input id="attachment" type="file" name="attachment" accept=".jpg,.jpeg,.png,.gif,.pdf">
                            </label>
                            <small>Maximum file size: 10 MB.</small>
                        </div>
                    </div>

                    <div class="record-form-actions">
                        <a href="/dashboard" class="record-cancel">Cancel</a>
                        <button type="submit" class="record-submit">Submit Record</button>
                    </div>
                </form>
            </section>
        </main>
    </div>
</body>
</html>