<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ticket Details - <%= ticket.tracking_code %></title>
</head>
<body style="font-family: Arial, sans-serif; padding: 40px; max-width: 700px; margin: 0 auto;">
    <h2>Ticket Details</h2>
    <a href="/admin/dashboard">← Back to Dashboard</a> | <a href="/feedback/track">Track another ticket</a>
    <hr>

    <div style="background: #f9f9f9; padding: 20px; border: 1px solid #ddd; margin-top: 20px;">
        <h3>[<%= ticket.tracking_code %>] <%= ticket.title %></h3>
        <p><strong>Status:</strong> <span style="color: blue;"><%= ticket.status %></span></p>
        <p><strong>Category:</strong> <%= ticket.category %></p>
        <p><strong>Location:</strong> <%= ticket.location %></p>
        <p><strong>Submission Type:</strong> <%= ticket.is_anonymous ? 'Anonymous' : 'Verified User' %></p>
        <p><strong>Date Submitted:</strong> <%= ticket.created_at %></p>
        
        <h4>Description:</h4>
        <p style="white-space: pre-line;"><%= ticket.description %></p>

        <% if (ticket.attachment_path) { %>
            <h4>Attachment / Evidence:</h4>
            <a href="<%= ticket.attachment_path %>" target="_blank" style="color: #007bff;">View Uploaded File / Evidence</a>
        <% } %>

        <% if (ticket.admin_remarks) { %>
            <h4>Official Administrative Remarks:</h4>
            <p style="background: #e9ecef; padding: 10px; border-left: 4px solid #007bff;"><%= ticket.admin_remarks %></p>
        <% } %>
    </div>
</body>
</html>