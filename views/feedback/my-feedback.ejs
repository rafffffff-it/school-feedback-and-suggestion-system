<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Feedback - EDUVoice</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-body">
  <main class="simple-page">
    <a class="simple-back-link" href="/dashboard">← Back to dashboard</a>
    <section class="simple-card">
      <div class="simple-page-heading">
        <h1>My Feedback</h1>
        <a class="dashboard-action primary" href="/feedback/new">＋ Submit Feedback</a>
      </div>
      <% if (submittedCode) { %>
        <div class="alert-success feedback-success">
          <strong>Your feedback was submitted successfully.</strong>
          <span>Tracking code: <%= submittedCode %></span>
        </div>
      <% } %>
      <% if (tickets.length === 0) { %>
        <p class="dashboard-empty-state">You have not submitted any feedback yet. <a href="/feedback/new">Create your first submission</a>.</p>
      <% } else { %>
        <div class="dashboard-table-wrap">
          <table class="dashboard-table">
            <thead><tr><th>Date</th><th>Category</th><th>Title</th><th>Status</th><th>Tracking Code</th></tr></thead>
            <tbody>
              <% tickets.forEach(ticket => { %>
                <tr>
                  <td><%= new Date(ticket.created_at).toLocaleDateString() %></td>
                  <td><%= ticket.category %></td>
                  <td><a href="/feedback/details/<%= ticket.id %>"><%= ticket.title %></a></td>
                  <td><span class="dashboard-status <%= ['Resolved', 'Closed'].includes(ticket.status) ? 'resolved' : ['Under Review', 'In Progress'].includes(ticket.status) ? 'in-progress' : 'pending' %>"><%= ticket.status %></span></td>
                  <td><%= ticket.tracking_code %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
